# MongoDB Connection String
# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.xxxxx.mongodb.net/youtube-videos?retryWrites=true&w=majority
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/youtube-videos
MONGODB_URI=mongodb://localhost:27017/youtube-videos

# YouTube Data API v3 Key
# Get this from: https://console.cloud.google.com/ > APIs & Services > Credentials
# Example: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_API_KEY=AIzaSyBZd4JfZmJJkfC_jlgTbJLExCTV38tTOSs

# Server Port
PORT=3000
